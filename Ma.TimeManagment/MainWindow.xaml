<Window x:Class="Ma.TimeManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ma.TimeManagement - Time Tracking for Azure DevOps" Height="500" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Config Inputs -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Server:"/>
            <TextBox x:Name="ServerUrlTextBox" Text="https://cicd-server" Width="150"/>
            <Label Content="Collection:"/>
            <TextBox x:Name="CollectionTextBox" Text="DefaultCollection" Width="100"/>
            <Label Content="Project:"/>
            <TextBox x:Name="ProjectTextBox" Width="100"/>
            <Label Content="PAT:"/>
            <PasswordBox x:Name="PatPasswordBox" Width="150"/>
            <Button Content="Connect and Fetch Tasks" Click="ConnectButton_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Create New Work Item Section -->
        <GroupBox Grid.Row="1" Header="Create New Work Item" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Type:"/>
                    <ComboBox x:Name="WorkItemTypeComboBox" Width="100" SelectedIndex="0">
                        <ComboBoxItem Content="Task"/>
                        <ComboBoxItem Content="User Story"/>
                    </ComboBox>
                    <Label Content="Title:"/>
                    <TextBox x:Name="NewTitleTextBox" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="Description:"/>
                    <TextBox x:Name="NewDescriptionTextBox" Width="200" Height="50" AcceptsReturn="True"/>
                    <Label Content="Parent ID (Epic/Feature/User Story):"/>
                    <TextBox x:Name="ParentIdTextBox" Width="100"/>
                </StackPanel>
                <Button Content="Create" Click="CreateWorkItemButton_Click" Margin="0,5,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </GroupBox>

        <!-- Task List Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Move Selected to Top and Start" Click="MoveToTopButton_Click" Margin="0,0,10,0"/>
        </StackPanel>

        <!-- Task List -->
        <ListView x:Name="TasksListView" Grid.Row="3" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Fields[System.Title]}"/>
                    <GridViewColumn Header="State" DisplayMemberBinding="{Binding Fields[System.State]}"/>
                    <GridViewColumn Header="Completed Work" DisplayMemberBinding="{Binding Fields[Microsoft.VSTS.Scheduling.CompletedWork]}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Timer Display -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Current Timer:"/>
            <TextBlock x:Name="TimerTextBlock" Text="00:00:00" FontSize="16" FontWeight="Bold"/>
            <Button x:Name="StartButton" Content="Start on Selected Task" Click="StartButton_Click" Margin="10,0,0,0"/>
            <Button x:Name="ResumeButton" Content="Resume" Click="ResumeButton_Click" Margin="10,0,0,0" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="Stop and Save" Click="StopButton_Click" Margin="10,0,0,0" IsEnabled="False"/>
        </StackPanel>

        <!-- Status & Minimize -->
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <TextBlock x:Name="StatusTextBlock" Text="Status: Ready" Foreground="Green"/>
            <Button Content="Minimize to Tray" Click="MinimizeButton_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>