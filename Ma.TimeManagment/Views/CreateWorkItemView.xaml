<UserControl x:Class="Ma.TimeManagement.Views.CreateWorkItemView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ma.TimeManagement.Views"
        mc:Ignorable="d"
        Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Create a new Work Item" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Label Content="Type:"/>
                <ComboBox SelectedIndex="{Binding SelectedTypeIndex}" Width="100">
                    <ComboBoxItem Content="Task"/>
                    <ComboBoxItem Content="User Story"/>
                </ComboBox>
                <Label Content="Title:"/>
                <TextBox Text="{Binding Title}" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                <Label Content="Description:"/>
                <TextBox Text="{Binding Description}" Width="200" AcceptsReturn="True"/>
                <Label Content="Parent ID (Epic/Feature/User Story):"/>
                <TextBox Text="{Binding ParentId}" Width="100"/>
            </StackPanel>
            <Button Content="Create" Command="{Binding CreateCommand}" Margin="0,5,0,0" HorizontalAlignment="Left">
            </Button>
        </StackPanel>
    </Grid>
</UserControl>