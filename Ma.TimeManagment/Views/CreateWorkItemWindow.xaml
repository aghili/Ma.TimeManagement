<Window x:Class="Ma.TimeManagement.Views.CreateWorkItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ma.TimeManagement.Views"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Create Work Item" Height="250" Width="500">
    <Grid Margin="10">
        <ui:CardControl Header="Create New Work Item">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Type:"/>
                    <ComboBox SelectedIndex="{Binding SelectedTypeIndex}" Width="100">
                        <ComboBoxItem Content="Task"/>
                        <ComboBoxItem Content="User Story"/>
                    </ComboBox>
                    <Label Content="Title:"/>
                    <ui:TextBox Text="{Binding Title}" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="Description:"/>
                    <ui:TextBox Text="{Binding Description}" Width="200" Height="50" AcceptsReturn="True"/>
                    <Label Content="Parent ID (Epic/Feature/User Story):"/>
                    <ui:TextBox Text="{Binding ParentId}" Width="100"/>
                </StackPanel>
                <ui:Button Content="Create" Icon="{ui:SymbolIcon Symbol=Add24}" Command="{Binding CreateCommand}" Margin="0,5,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </ui:CardControl>
    </Grid>
</Window>