<UserControl x:Class="Ma.TimeManagement.Views.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:viewmodels="clr-namespace:Ma.TimeManagement.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        Loaded="Window_Loaded">
    <UserControl.Resources>
        <CollectionViewSource x:Key="employeeView" Source="{Binding Tasks}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="ProjectName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="Time Management Assistante" FontSize="24"/>
        </StackPanel>

        <!-- Task List -->
        <ListView  x:Name="TasksListView" Grid.Row="1" ItemsSource="{Binding Source={StaticResource employeeView}}" SelectedItem="{Binding SelectedTask}" MouseDoubleClick="TasksListView_MouseDoubleClick" MinHeight="250">

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Expander
                                        Padding="0"                                           
                                        BorderThickness="0"
                                        IsExpanded="True">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="5"/>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5" >
                        <Grid.RowDefinitions >
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Width="500" Value="{Binding CompletedWork}" Maximum="{Binding TotalWork}"/>
                        <TextBlock Grid.Row="0" Text="{Binding Id}" Padding="0,0,10,0" />
                        <TextBlock Grid.Row="1" Text="{Binding State}" Padding="0,0,10,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                            <TextBlock Grid.Column="1" Text="["/>
                            <TextBlock FontWeight="Bold" Grid.Column="0" Text="{Binding WorkItemType }"/>
                            <TextBlock Grid.Column="1" Text="] "/>
                            <TextBlock  FontWeight="Bold" Grid.Column="2" Text="{Binding Title}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2"  FontWeight="Bold" Text="{Binding RemainingWork,StringFormat={}{0:f1}H Left}"/>
                            <TextBlock Grid.Column="0"  FontWeight="Bold" Text="{Binding TotalWork,StringFormat={}{0:f1}h}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!-- Task List Controls --><!--
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Move Selected to Top and Start" Command="{Binding MoveToTopCommand}" Margin="0,0,10,0"/>
        </StackPanel>-->
        
        <!-- Timer Display -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Start on Selected Task" Command="{Binding StartCommand}" Margin="10,0,0,0"/>
            <Button Content="Stop and Save" Command="{Binding StopCommand}" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}#: {1} ">
                        <Binding Path="WorkItemID" />
                        <Binding Path="WorkItemTitle" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="{Binding TimerText}" FontSize="16" FontWeight="Bold"/>
        </StackPanel>


        <!-- Status & Minimize -->
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <TextBlock Text="{Binding Status}" Foreground="Green"/>
        </StackPanel>
    </Grid>
</UserControl>