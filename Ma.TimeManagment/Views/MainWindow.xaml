<Window x:Class="Ma.TimeManagement.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:viewmodels="clr-namespace:Ma.TimeManagement.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        Title="Ma.TimeManagement - Time Tracking for Azure DevOps" Height="500" Width="600"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Open Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Settings" Click="OpenSettings_Click" Margin="0,0,10,0"/>
            <Button Content="Create Work Item" Click="OpenCreate_Click"/>
        </StackPanel>

        <!-- Task List Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Move Selected to Top and Start" Command="{Binding MoveToTopCommand}" Margin="0,0,10,0"/>
        </StackPanel>

        <!-- Task List -->
        <ListView x:Name="TasksListView" Grid.Row="2" Margin="0,0,0,10" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Fields[System.Title]}"/>
                    <GridViewColumn Header="State" DisplayMemberBinding="{Binding Fields[System.State]}"/>
                    <GridViewColumn Header="Completed Work" DisplayMemberBinding="{Binding Fields[Microsoft.VSTS.Scheduling.CompletedWork]}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Timer Display -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Current Timer:"/>
            <TextBlock Text="{Binding TimerText}" FontSize="16" FontWeight="Bold"/>
            <Button Content="Start on Selected Task" Command="{Binding StartCommand}" Margin="10,0,0,0"/>
            <Button Content="Resume" Command="{Binding ResumeCommand}" Margin="10,0,0,0" IsEnabled="{Binding IsResumeEnabled}"/>
            <Button Content="Stop and Save" Command="{Binding StopCommand}" Margin="10,0,0,0" IsEnabled="{Binding IsStopEnabled}"/>
        </StackPanel>

        <!-- Status & Minimize -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="{Binding Status}" Foreground="Green"/>
            <Button Content="Minimize to Tray" Command="{Binding MinimizeCommand}" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>