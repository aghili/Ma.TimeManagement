<Window x:Class="Ma.TimeManagement.Views.TaskDiscussionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Ma.TimeManagement.Converters" 
        xmlns:viewmodels="clr-namespace:Ma.TimeManagement.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        Title="Enter Task Discution" SizeToContent="Height" WindowStartupLocation="CenterOwner" MinWidth="500" Width="500">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical">
            <TextBlock Text="Enter Discussion for Task :" FontSize="14"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="ID :" />
                <TextBlock Text="{Binding Task.Id}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Title :" />
                <TextBlock Text="{Binding Task.Title}"/>
            </StackPanel>
        </StackPanel>
        <TextBox Grid.Row="1" Text="{Binding Discussion}" TextWrapping="Wrap"
  AcceptsReturn="True"
  VerticalScrollBarVisibility="Visible"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="6" Padding="8,4" Click="OnCancel" />
            <Button Content="Accept" Margin="6" Padding="8,4" Click="OnAccept" />
        </StackPanel>
    </Grid>
</Window>