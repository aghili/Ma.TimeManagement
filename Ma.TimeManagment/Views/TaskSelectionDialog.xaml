<Window x:Class="Ma.TimeManagement.Views.TaskSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Ma.TimeManagement.Converters"
        Title="Select Task" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" MinWidth="500">
  <Window.Resources>
    <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
    <CollectionViewSource x:Key="GroupedTasks" Source="{Binding AvailableTasks}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="ProjectName"/>
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Choose a task:" FontWeight="Bold" FontSize="14"/>

    <ListView Grid.Row="1" ItemsSource="{Binding Source={StaticResource GroupedTasks}}"
              SelectedItem="{Binding SelectedTask}" Margin="0,8,0,8">
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="Bold" Background="#EEE" Padding="4" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" >
            <TextBlock Text="{Binding Title}" />
            <TextBlock Text=" " Width="12"/>
            <TextBlock Text="{Binding DueDate, StringFormat='(Due {0:yyyy-MM-dd})'}" Foreground="Gray" FontSize="12"/>
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <ListView Grid.Row="2" ItemsSource="{Binding WorkCalendarItems}" SelectedItem="{Binding SelectedWorkCalendarItem}" SelectionChanged="ListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="{Binding StartTime, StringFormat=HH:mm}" FontSize="12"/>
                        <TextBlock Text="{Binding DurationHour ,StringFormat={}{0}h}" />
                        <TextBlock Text=" " Width="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock  Text="Start :"/>
            <TextBox x:Name="txt_StartTime" ToolTip="Time of start" Text="{Binding StartTime,StringFormat={}{0:HH:mm}}"/>
            <TextBlock  Text="Duration :"/>
            <TextBox x:Name="txt_duration" ToolTip="Hour" Text="{Binding Duration,StringFormat={}{0:2}h}"/>
        </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Margin="6" Padding="8,4" Click="OnCancel"/>
      <Button Content="Start Task" Margin="6" Padding="8,4" Click="OnStart"
              IsEnabled="{Binding SelectedTask, Converter={StaticResource NullToBoolConverter}}"/>
    </StackPanel>
  </Grid>
</Window>