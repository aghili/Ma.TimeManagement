<UserControl x:Class="Ma.TimeManagement.Views.TimeLIneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ma.TimeManagement.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Ma.TimeManagement.ViewModels" 
             xmlns:system="clr-namespace:System;assembly=netstandard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:TimelineViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600" d:DesignWidth="1200"
             x:Name="Root"
             Background="#1E1E1E">

    <UserControl.Resources>
        <conv:DurationToWidthConverter x:Key="DurationToWidth"/>
        <conv:HourRangeConverter x:Key="HourRange"/>
        <conv:TrackYConverter x:Key="TrackY"/>
        <conv:TimeToXMultiConverter x:Key="TimeToXMulti"/>

        <!-- Nice track spacing -->
        <system:Double x:Key="TrackHeight">85</system:Double>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      PanningMode="HorizontalOnly">

            <StackPanel HorizontalAlignment="Left">
                <!-- Time Ruler (08:00 – 22:00) -->
                <Border Height="60" Background="#252526" BorderBrush="#444" BorderThickness="0,0,0,1">
                    <Canvas Width="{Binding DataContext.TimelineWidth, ElementName=Root}">
                        <ItemsControl ItemsSource="{Binding Source=8, Converter={StaticResource HourRange}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                    <!-- Hour Line -->
                                    <Line Y1="0" Y2="60"
                                          Stroke="#666" StrokeThickness="1">
                                        <Line.X1>
                                            <MultiBinding Converter="{StaticResource TimeToXMulti}">
                                                <Binding Path="."/>
                                                <Binding Path="DataContext.Zoom" ElementName="Root"/>
                                            </MultiBinding>
                                        </Line.X1>
                                        <Line.X2>
                                            <MultiBinding Converter="{StaticResource TimeToXMulti}">
                                                <Binding Path="."/>
                                                <Binding Path="DataContext.Zoom" ElementName="Root"/>
                                            </MultiBinding>
                                        </Line.X2>
                                    </Line>

                                    <!-- Hour Label -->
                                    <TextBlock Text="{Binding StringFormat=HH:mm}"
                                               Foreground="#CCCCCC" FontSize="13" FontWeight="Medium"
                                               Margin="6,32,0,0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform>
                                                <TranslateTransform.X>
                                                    <MultiBinding Converter="{StaticResource TimeToXMulti}">
                                                        <Binding Path="."/>
                                                        <Binding Path="DataContext.Zoom" ElementName="Root"/>
                                                    </MultiBinding>
                                                </TranslateTransform.X>
                                            </TranslateTransform>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Border>

                <!-- Timeline Tracks -->
                <Canvas Width="{Binding DataContext.TimelineWidth, ElementName=Root}"
                        Height="600" Margin="0,15,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding DataContext.TimelineWidth, ElementName=Root}" Height="300"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="{Binding Background}"
                                        Padding="18,12"
                                        MinHeight="70"
                                        ToolTip="{Binding Title}"
                                        Cursor="Hand">

                                    <!-- Width -->
                                    <Button.Width>
                                        <MultiBinding Converter="{StaticResource DurationToWidth}">
                                            <Binding Path="StartTime"/>
                                            <Binding Path="EndTime"/>
                                            <Binding Path="DataContext.Zoom" ElementName="Root"/>
                                        </MultiBinding>
                                    </Button.Width>

                                    <!-- Position -->
                                    <Button.RenderTransform>
                                        <TranslateTransform>
                                            <TranslateTransform.X>
                                                <MultiBinding Converter="{StaticResource TimeToXMulti}">
                                                    <Binding Path="StartTime"/>
                                                    <Binding Path="DataContext.Zoom" ElementName="Root"/>
                                                </MultiBinding>
                                            </TranslateTransform.X>

                                        </TranslateTransform>
                                    </Button.RenderTransform>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StartTime}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
           Text=" - "
           Foreground="#AAAAAA"
           FontSize="11"
           HorizontalAlignment="Right"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
           Text="{Binding EndTime}"
           Foreground="#AAAAAA"
           FontSize="11"
           HorizontalAlignment="Right"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>

                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.AlternationCount>50</ItemsControl.AlternationCount>
                    </ItemsControl>
                    <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Content="START" Height="100"/>
                        <Button Grid.Row="1" Content="MANUAL" Height="100"/>

                    </Grid>
                    </Grid>
                </Canvas>
            </StackPanel>
        </ScrollViewer>

        <!-- Zoom Controls -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="24"
                    Background="#CC000000">
            <Button Content="−" Width="48" Height="48" Margin="4" FontSize="24" FontWeight="Bold"
                    Command="{Binding ZoomOutCommand}"/>
            <Button Content="Reset" Width="90" Height="48" Margin="4" FontWeight="Medium"
                    Command="{Binding ResetCommand}"/>
            <Button Content="+" Width="48" Height="48" Margin="4" FontSize="24" FontWeight="Bold"
                    Command="{Binding ZoomInCommand}"/>
        </StackPanel>

        <!-- Current Time Indicator (Optional Bonus) -->
        <Line X1="0" X2="0" Y1="0" Y2="{Binding ActualHeight, ElementName=Root}"
              Stroke="Red" StrokeThickness="2" Opacity="0.7"
              RenderTransformOrigin="0,0">
            <Line.RenderTransform>
                <TranslateTransform>
                    <TranslateTransform.X>
                        <MultiBinding Converter="{StaticResource TimeToXMulti}">
                            <Binding Source="{x:Static system:DateTime.Now}"/>
                            <Binding Path="DataContext.Zoom" ElementName="Root"/>
                        </MultiBinding>
                    </TranslateTransform.X>
                </TranslateTransform>
            </Line.RenderTransform>
        </Line>
    </Grid>
</UserControl>