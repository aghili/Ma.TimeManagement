<Window x:Class="Ma.TimeManagement.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ma.TimeManagement.Windows"
        xmlns:vm="clr-namespace:Ma.TimeManagement.ViewModels"
        xmlns:view="clr-namespace:Ma.TimeManagement.Views" 
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Ma.TimeManagement - Time Tracking for Azure DevOps" Width="800" MinWidth="800" MinHeight="600">
        <Window.Resources>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <view:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <view:SettingsView />
            </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateWorkItemViewModel}">
            <view:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
            <view:TimeLineView />
        </DataTemplate>
    </Window.Resources>

        <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Home" Command="{Binding NavigateHomeCommand}" />
            <Button Content="Timeline" Command="{Binding NavigateTimelineCommand}" />
            <Button Content="Settings" Command="{Binding NavigateSettingsCommand}" />
            </StackPanel>

            <ContentControl Grid.Row="1" Margin="20,0,20,0" Content="{Binding CurrentViewModel}" />
        <Grid Grid.Row="2" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Message}"/>
            <Button Grid.Column="1" Content="Minimize to Tray" Command="{Binding MinimizeCommand}" Margin="10,0,0,0"/>
        </Grid>
        </Grid>
    </Window>